# Copy this file to .env and fill in real values — never commit .env
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ขึ้น git

# Apps Script Web App this service caches (the /exec URL of the deployment)
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# How often each part is re-fetched, in seconds
REFRESH_SECONDS=300

# Where the last good copy of each part is kept between restarts
CACHE_DIR=/data/cache

# Browser origins allowed to call this API (comma separated)
ALLOWED_ORIGINS=https://teamklang-warehouse-kpi.pages.dev,http://localhost:5199
